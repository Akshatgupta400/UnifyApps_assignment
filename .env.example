# Copy to .env and fill in. Only the API key for your chosen provider is required.
GROQ_API_KEY=gsk_...          # free key: https://console.groq.com/keys
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...
# GOOGLE_API_KEY=...

# "provider:model" understood by langchain.chat_models.init_chat_model
LLM_MODEL=groq:openai/gpt-oss-120b
# Comma-separated models tried when the main one fails, e.g. its daily free quota is used up
LLM_FALLBACK_MODELS=groq:openai/gpt-oss-20b
LLM_TEMPERATURE=0

# Database (created and seeded automatically on first start if missing)
DATABASE_PATH=data/sample.db

# Agent behaviour
AUTO_EXECUTE=true          # run validated SELECTs against the sample DB
MAX_RESULT_ROWS=200        # rows returned to the UI
MAX_EXPORT_ROWS=10000      # rows written to a CSV export
QUERY_TIMEOUT_SECONDS=5
MAX_SQL_ATTEMPTS=3         # first attempt + automatic repairs after failed validation
HISTORY_TURNS=6            # previous turns given to the LLM as context

# Server
HOST=127.0.0.1
PORT=8000
